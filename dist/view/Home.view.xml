<mvc:View
    controllerName="com.emami.fmfodeviation.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <customHeader> 
            <Toolbar class="bgTitle">
                <Image
                    src="https://play-lh.googleusercontent.com/vUhttkqY8FHqm6I-r0T210GBeH-9co97zc0D5dtUBqMWPhbdZdw9Kh3FDFOKFpQKLoPPgpviRZzWRBtD-Txgnw=w600-h300-pc0xffffff-pd"
                    height="3rem"
                    width="6rem"
                    class="sapUiMediumMarginEnd"
                />
                <FlexBox
                    alignItems="Start"
                    justifyContent="Center"
                >
                    <Text
                        text="FM FO Deviation"
                        class="sapUiLargeMarginBegin"
                    />
                </FlexBox>
                <!-- <Text
                    text="FM FO Deviation"
                    class="whiteText sapUiMediumMarginBegin"
                /> -->
            </Toolbar>
        </customHeader>
        <content>
            <IconTabBar
                stretchContentHeight="false"
                backgroundDesign="Solid"
                class="sapUiResponsiveContentPadding"
                select="onPressHeaderIconTabBar"
                id="idTabOuter"
            >
                <items>
                    <IconTabFilter
                        icon="sap-icon://hr-approval"
                        iconColor="Positive"
                        text="My Approvals"
                        key="My Approvals"
                    >
                        <core:Fragment
                            fragmentName="com.emami.fmfodeviation.view.fragments.MyApprovals"
                            type="XML"
                        />
                    </IconTabFilter>
                    <IconTabFilter
                        icon="sap-icon://history"
                        iconColor="Critical"
                        text="History"
                        key="History"
                    >
                        <core:Fragment
                            fragmentName="com.emami.fmfodeviation.view.fragments.History"
                            type="XML"
                        />
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>

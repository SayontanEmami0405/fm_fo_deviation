<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:grid="sap.ui.layout.cssgrid"
    xmlns:f="sap.f"
>
    <f:GridList items="{jsonApprovedModel>/}">
        <f:GridListItem
            press="onPressLineItemHistoryApproved"
            type="Active"
        >
            <Panel class="Test">
                <VBox class="sapUiSmallMargin">
                    <layoutData>
                        <FlexItemData
                            growFactor="1"
                            shrinkFactor="0"
                        />
                    </layoutData>

                    <HBox class="sapUiTinyMarginTop">
                        <Text
                            text="Date : { path : 'jsonApprovedModel>Erdat' , type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd/MM/yyyy'}} - Time : {path: 'jsonApprovedModel>Uzeit' , type: 'sap.ui.model.odata.type.Time', formatOptions: {pattern: 'HH:mm:ss'}} "
                        />
                    </HBox>

                    <HBox class="sapUiTinyMarginTop">
                        <Label
                            design="Bold"
                            text="{jsonApprovedModel>Kwmeng} {jsonApprovedModel>Meins}"
                        />
                        <Link
                            class="sapUiTinyMarginBegin"
                            text="Depot Comment"
                            press="onHandleLinkPressDepotCommentApproved"
                        />
                    </HBox>
                    <HBox class="sapUiTinyMarginTop">
                        <Label
                            wrapping="true"
                            wrappingType="Normal"
                            design="Bold"
                            text="{jsonApprovedModel>Vbeln} / {jsonApprovedModel>Posnr} / {jsonApprovedModel>Kunnr} / {jsonApprovedModel>Name1} / {jsonApprovedModel>Werks}"
                        />
                    </HBox>
                    <HBox class="sapUiTinyMarginTop">
                        <Text
                            wrapping="true"
                            wrappingType="Normal"
                            text="{jsonApprovedModel>Matnr} / {jsonApprovedModel>Arktx}"
                        />
                    </HBox>
                    <HBox class="sapUiTinyMarginTop">
                        <Link
                            text="Initiator Comment"
                            press="onHandleLinkPressInitiatorApproved"
                        />
                    </HBox>
                    <!-- <HBox class="sapUiTinyMarginTop">
                         <Text
                            text="Reason Code : {jsonApprovedModel>}"
                        />
                       
                    </HBox> -->
                    <!-- <HBox class="sapUiTinyMarginTop">
                           <Text
                            text="Depot Comment : {jsonApprovedModel>AddInfo}"
                        />
                    </HBox> -->
                </VBox>
            </Panel>
        </f:GridListItem>
    </f:GridList>
</core:FragmentDefinition>

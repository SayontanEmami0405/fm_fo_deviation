<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:grid="sap.ui.layout.cssgrid"
    xmlns:f="sap.f"
>
    <f:GridList items="{jsonMyApprovalsModel>/}" >
        <f:GridListItem
            press="onPressLineItemMyApprovals"
            type="Active"
        >
            <Panel >
                <VBox class="sapUiSmallMargin">
                    <layoutData>
                        <FlexItemData
                            growFactor="1"
                            shrinkFactor="0"
                        />
                    </layoutData>

                    <HBox class="sapUiTinyMarginTop">
                        <Text
                            text="Date : { path : 'jsonMyApprovalsModel>Erdat' , type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd/MM/yyyy'}} - Time : {path: 'jsonMyApprovalsModel>Uzeit' , type: 'sap.ui.model.odata.type.Time', formatOptions: {pattern: 'HH:mm:ss'}} "
                        />
                    </HBox>

                    <HBox class="sapUiTinyMarginTop">
                        <Label
                            design="Bold"
                            text="{jsonMyApprovalsModel>Kwmeng} {jsonMyApprovalsModel>Meins}"
                        />
                        <Link
                            class="sapUiTinyMarginBegin"
                            text="Depot Comment"
                            press="onHandleLinkPressDepotCommentMyApprovals"
                        />
                    </HBox> 
                    <HBox class="sapUiTinyMarginTop">
                        <Label
                            wrapping="true"
                            wrappingType="Normal"
                            design="Bold"
                            text="{jsonMyApprovalsModel>Vbeln} / {jsonMyApprovalsModel>Posnr} / {jsonMyApprovalsModel>Kunnr} / {jsonMyApprovalsModel>Name1} / {jsonMyApprovalsModel>Werks}"
                        />
                    </HBox>
                    <HBox class="sapUiTinyMarginTop">
                        <Text
                            wrapping="true"
                            wrappingType="Normal"
                            text="{jsonMyApprovalsModel>Matnr} / {jsonMyApprovalsModel>Arktx}"
                        />
                    </HBox>
                    <!-- <HBox class="sapUiTinyMarginTop">
                        <Text text="Reason Code : {jsonMyApprovalsModel>}" />
                    </HBox> 
                    <HBox class="sapUiTinyMarginTop">
                        <Text
                            text="Depot Comment : {jsonMyApprovalsModel>AddInfo}"
                        />
                        <Link
                            text="Depot Comment"
                            press="onHandleLinkPress"
                        />
                    </HBox>
                    <HBox
                        class="sapUiTinyMarginTop"
                        width="100%"
                    >
                        <TextArea
                            width="15rem"
                            growing="true"
                            height="4rem"
                            visible="{= ${jsonMyApprovalsModel>StatusWf} === 'S00' ? true : false }"
                            editable="{= ${jsonMyApprovalsModel>StatusWf} === 'S00' ? true : false }"
                            value="{jsonMyApprovalsModel>InitRem}"
                        />
                    </HBox> -->
                    <HBox class="sapUiTinyMarginTop">
                        <Link
                            text="Initiator Comment"
                            visible="{= ${jsonMyApprovalsModel>StatusWf} === 'S00' ? false : true }"
                            press="onHandleLinkPressInitiatorMyApprovals"
                        /> 
                    </HBox>
                    <HBox
                        justifyContent="SpaceBetween"
                        class="sapUiResponsiveContentPadding sapUiTinyMarginTop"
                    >
                        <Button
                            icon="sap-icon://error"
                            type="Reject"
                            press="onPressShowError"
                        />
                        <Button
                            text="Accept"
                            type="Accept"
                            press="onPressAccept"
                        />
                        <Button
                            text="Reject"
                            type="Reject"
                            press="onPressReject"
                        />
                    </HBox>
                </VBox>
            </Panel>
        </f:GridListItem>
    </f:GridList>
</core:FragmentDefinition>

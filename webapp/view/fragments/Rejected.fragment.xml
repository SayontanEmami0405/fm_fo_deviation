<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:grid="sap.ui.layout.cssgrid"
    xmlns:f="sap.f"
>
    <f:GridList items="{jsonRejectedModel>/}">
        <f:GridListItem
            press="onPressLineItemHistoryRejected"
            type="Active"
        >
            <Panel class="Test">
                <VBox class="sapUiSmallMargin">
                    <layoutData>
                        <FlexItemData
                            growFactor="1"
                            shrinkFactor="0"
                        />
                    </layoutData>

                    <HBox class="sapUiTinyMarginTop">
                        <Text
                            text="Date : { path : 'jsonRejectedModel>Erdat' , type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd/MM/yyyy'}} - Time : {path: 'jsonRejectedModel>Uzeit' , type: 'sap.ui.model.odata.type.Time', formatOptions: {pattern: 'HH:mm:ss'}} "
                        />
                    </HBox>

                    <HBox class="sapUiTinyMarginTop">
                        <Label
                            design="Bold"
                            text="{jsonRejectedModel>Kwmeng} {jsonRejectedModel>Meins}"
                        />
                        <Link
                            class="sapUiTinyMarginBegin"
                            text="Depot Comment"
                            press="onHandleLinkPressDepotCommentRejected"
                        />
                    </HBox>
                    <HBox class="sapUiTinyMarginTop">
                        <Label
                            wrapping="true"
                            wrappingType="Normal"
                            design="Bold"
                            text="{jsonRejectedModel>Vbeln} / {jsonRejectedModel>Posnr} / {jsonRejectedModel>Kunnr} / {jsonRejectedModel>Name1} / {jsonRejectedModel>Werks}"
                        />
                    </HBox>
                    <HBox class="sapUiTinyMarginTop">
                        <Text
                            wrapping="true"
                            wrappingType="Normal"
                            text="{jsonRejectedModel>Matnr} / {jsonRejectedModel>Arktx}"
                        />
                    </HBox>
                    <HBox class="sapUiTinyMarginTop">
                        <Link
                            text="Initiator Comment"
                            press="onHandleLinkPressInitiatorRejected"
                        />
                    </HBox>
                    <!-- <HBox class="sapUiTinyMarginTop">
                         <Text
                            text="Reason Code : {jsonRejectedModel>}"
                        />
                       
                    </HBox> -->
                    <!-- <HBox class="sapUiTinyMarginTop">
                        <Text
                            text="Depot Comment : {jsonRejectedModel>AddInfo}"
                        />
                    </HBox> -->
                </VBox>
            </Panel>
        </f:GridListItem>
    </f:GridList>
</core:FragmentDefinition>
